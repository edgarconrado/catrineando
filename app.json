{
  "expo": {
    "name": "catrineando",
    "slug": "catrineando",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catrineando",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Catrineando usa la cámara para tomar tu foto y convertirla en Catrín o Catrina.",
        "NSPhotoLibraryUsageDescription": "Catrineando accede a tus fotos para que elijas una y la convirtamos en Catrín o Catrina.",
        "NSPhotoLibraryAddUsageDescription": "Catrineando guarda tu catrina en tu galería."
      },
      "bundleIdentifier": "com.jacarandalab.catrineando"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jacarandalab.catrineando"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.33078112886-2llcc8cq6kn0sk5s0j6k7i27jah9cfug"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Catrineando usa la cámara para tomar tu foto y convertirla en Catrín o Catrina.",
          "photosPermission": "Catrineando accede a tus fotos para que elijas una y la convirtamos en Catrín o Catrina."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Catrineando guarda tu catrina en tu galería.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-web-browser"
        ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa298a43-8970-4ac1-9e64-b40c3bd71ad9"
      }
    }
  }
}